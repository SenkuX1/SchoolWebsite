/* Базовый сброс и настройки шрифтов */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Roboto', sans-serif;
  color: #333333;
  background-color: #faf8f5;
  line-height: 1.6;
}

h1, h2, h3 {
  font-family: 'Lora', serif;
}

/* Главный экран */
.section-main {
  background-color: #2c4c3b;
  color: #ffffff;
  text-align: center;
  padding: 80px 20px;
}

.section-main-logo {
  width: 80px;
  height: auto;
  margin-bottom: 20px;
}

.section-main-title {
  font-size: 48px;
  font-weight: 700;
  margin-bottom: 12px;
}

.section-main-subtitle {
  font-family: 'Roboto', sans-serif;
  font-size: 20px;
  font-weight: 300;
  margin-bottom: 32px;
  color: #e0e8e3;
}

.section-main-button {
  background-color: #d4a373;
  color: #ffffff;
  border: none;
  padding: 14px 32px;
  font-size: 16px;
  font-weight: 500;
  border-radius: 6px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.section-main-button:hover {
  background-color: #bc8a5f;
}

/* Вторая секция: О библиотеке */
.second-section {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 50px;
  max-width: 1100px;
  margin: 80px auto;
  padding: 0 20px;
}

.second-section-img {
  width: 45%;
  max-width: 480px;
  border-radius: 10px;
  object-fit: cover;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
}

.second-section-info {
  width: 55%;
}

.second-section-subtitle,
.third-section-subtitle {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: #2c4c3b;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.second-section-title,
.third-section-title {
  font-size: 36px;
  color: #1f2421;
  margin-bottom: 20px;
}

.second-section-text {
  font-size: 16px;
  color: #555555;
  margin-bottom: 24px;
}

.second-section-name {
  font-size: 15px;
  color: #666666;
}

.second-section-name2 {
  font-weight: 700;
  color: #2c4c3b;
}

/* Третья секция: Коллекция книг */
.third-section {
  max-width: 1100px;
  margin: 80px auto;
  padding: 0 20px;
  text-align: center;
}

.third-section-books {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  margin-top: 40px;
}

.third-section-book {
  background-color: #ffffff;
  border-radius: 8px;
  padding: 20px;
  width: 25%;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  transition: transform 0.3s ease;
}

.third-section-book:hover {
  transform: translateY(-5px);
}

.book-img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  border-radius: 4px;
  margin-bottom: 16px;
}

.book-title {
  font-size: 18px;
  color: #1f2421;
  margin-bottom: 6px;
}

.book-author {
  font-size: 14px;
  color: #777777;
  margin-bottom: 12px;
}

.book-price {
  font-size: 16px;
  font-weight: 700;
  color: #2c4c3b;
}

/* Футер и форма */
.footer {
  background-color: #1f2421;
  color: #ffffff;
  text-align: center;
  padding: 70px 20px;
}

.footer-subtitle {
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: #d4a373;
  margin-bottom: 8px;
}

.footer-title {
  font-size: 32px;
  margin-bottom: 16px;
}

.footer-text {
  max-width: 600px;
  margin: 0 auto 36px;
  font-size: 15px;
  color: #cccccc;
}

.footer-text-main {
  display: block;
  margin-bottom: 8px;
}

.footer-form {
  max-width: 400px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  text-align: left;
}

.form-title {
  font-size: 14px;
  margin-bottom: 6px;
  color: #e0e0e0;
}

.form-input {
  padding: 12px;
  margin-bottom: 18px;
  border: 1px solid #444444;
  border-radius: 6px;
  background-color: #2b302d;
  color: #ffffff;
  font-size: 15px;
}

.form-input:focus {
  outline: none;
  border-color: #d4a373;
}

.footer-button {
  background-color: #d4a373;
  color: #ffffff;
  border: none;
  padding: 14px;
  font-size: 16px;
  font-weight: 500;
  border-radius: 6px;
  cursor: pointer;
  margin-top: 8px;
  transition: background-color 0.3s ease;
}

.footer-button:hover {
  background-color: #bc8a5f;
}
